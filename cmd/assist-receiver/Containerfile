FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/assist/ internal/assist/
COPY cmd/assist-receiver/ cmd/assist-receiver/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /assist-receiver ./cmd/assist-receiver

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /assist-receiver /assist-receiver
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/assist-receiver"]
