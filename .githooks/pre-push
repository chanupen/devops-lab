#!/bin/sh
# Refuse any push to main. Work goes to a branch and reaches main through a
# pull request. Enable in a clone with: git config core.hooksPath .githooks
#
# git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: refusing to push to main ($local_ref -> $remote_ref): push to a branch and open a PR" >&2
		status=1
	fi
done
exit $status
